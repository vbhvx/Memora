# Database connection
DATABASE_URL=postgres://localhost:5432/memora
TEST_DATABASE_URL=postgres://localhost:5432/memora_test

# Authentication & Session Security
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters

# Application Base URL (used for absolute share links)
APP_URL=http://localhost:3000

# AI Provider Configuration
# Supported providers: mock | openai | anthropic | gemini
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=memora-ai-mock-v1

