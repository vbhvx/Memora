# Database Connection (Neon Serverless PostgreSQL or Local PostgreSQL)
# Example Neon Connection String:
# DATABASE_URL=postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://localhost:5432/memora
TEST_DATABASE_URL=postgres://localhost:5432/memora_test

# Clerk Authentication (Get these from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Google Gemini API (Get your API key from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
AI_PROVIDER=gemini

# Application Session Security & Base URL
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters
APP_URL=http://localhost:3000
